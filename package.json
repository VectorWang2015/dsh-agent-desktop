{
  "name": "dsh-agent-desktop",
  "version": "0.2.0",
  "description": "Host-native background graphical sessions for AI with a DSH sidebar monitor and explicit human takeover.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VectorWang2015/dsh-agent-desktop.git"
  },
  "homepage": "https://github.com/VectorWang2015/dsh-agent-desktop#readme",
  "bugs": { "url": "https://github.com/VectorWang2015/dsh-agent-desktop/issues" },
  "icon": "./assets/icon.svg",
  "packageManager": "pnpm@11.7.0",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js", "lib/client.js", "lib/client.css",
    "runtime/desktop_worker.py",
    "scripts/setup-native.py", "scripts/setup-native.sh",
    "assets/icon.svg", "locale/en.json", "locale/zh.json",
    "cordis.patch.yml", "README.md", "USAGE.md", "LICENSE", "THIRD_PARTY_NOTICES.md",
    "docs/architecture.md", "docs/validation.md", "docs/plugin-compliance.md", "docs/gui-pitfalls.md", "CHANGELOG.md",
    "examples/first-task.zh.md", "examples/desktop-demo.py"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run && /usr/bin/python3 tests/worker_cleanup_test.py && /usr/bin/python3 tests/demo_test.py",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "test:smoke": "DESKTOP_NATIVE_SMOKE=1 vitest run tests/native.smoke.test.ts tests/native-feedback.smoke.test.ts",
    "test:worker": ".runtime/venv/bin/python -B -m unittest discover -s tests -p 'worker*_test.py'",
    "test:ide": "DESKTOP_VSCODE_SMOKE=1 vitest run tests/native-vscode.smoke.test.ts",
    "package:check": "node scripts/check-package.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm package:check"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": { "schemastery": "3.18.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "react": "18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.7-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@types/node": "22.20.4", "@types/react": "18.3.31", "@types/react-dom": "18.3.7",
    "clsx": "2.1.1", "zustand": "4.4.7", "immer": "10.1.1", "esbuild": "0.25.12", "jsdom": "26.1.0",
    "react": "18.3.1", "react-dom": "18.3.1", "typescript": "5.9.3", "vitest": "3.2.7"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": "0.1.7-rc.2" }
}
